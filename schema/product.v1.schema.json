{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextbridge.dev/schema/product.v1.schema.json",
  "title": "Nextbridge product manifest v1",
  "description": "Describes what a product is. Lives at .nextbridge/product.yaml in the product's own repository. The product owns this file; the ecosystem never writes to it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "problem",
    "user",
    "capabilities",
    "interfaces",
    "distribution",
    "runtime",
    "license",
    "maturity"
  ],
  "properties": {
    "schema": {
      "const": "nextbridge.dev/product/v1"
    },
    "id": {
      "$ref": "#/$defs/slug",
      "description": "Stable ecosystem-wide identifier. Must match the key used in registry.yaml."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name."
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["short"],
      "properties": {
        "short": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "description": "One line, for listings and marketplace entries."
        },
        "long": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        }
      }
    },
    "problem": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000,
      "description": "The user problem this product exists to solve. A problem statement, not a feature list."
    },
    "user": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/userType" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core"],
      "properties": {
        "core": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" },
          "description": "Resolved against taxonomy/capabilities.yaml by rule R-REF1."
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/interface" },
      "description": "How the product is used. Claude Code plugins and Gemini CLI extensions are NOT interfaces here - they are declared once in plugins[]. May be empty for a product whose only surface is a plugin; rule R-REF9 requires at least one interface or one plugin."
    },
    "distribution": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/distribution" },
      "description": "How the product is obtained. The claude-code-marketplace channel is generated by the compiler from plugins[] and must not be hand-authored."
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX identifier."
    },
    "maturity": {
      "enum": ["experimental", "stable", "integrated"],
      "description": "experimental: may change or break. stable: tested, documented, versioned, independently usable. integrated: stable plus at least one verified integration with another Nextbridge product (rule R-REF5)."
    },
    "plugins": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/plugin" },
      "description": "Agent-host plugins this product ships. Absent or empty is normal and valid."
    },
    "integrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/integration" },
      "description": "Relationships this product implements. May target non-Nextbridge products via external: true. Absent or empty is normal and valid."
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "userType": {
      "enum": [
        "ai-agent-developer",
        "developer-using-ai-agent",
        "javascript-developer",
        "package-maintainer",
        "repository-maintainer",
        "engineering-lead",
        "cms-developer",
        "content-editor"
      ]
    },
    "interface": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "cli",
            "mcp",
            "library",
            "github-action",
            "http-endpoints",
            "desktop-app",
            "pre-commit-hook"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "cli" } }, "required": ["type"] },
          "then": {
            "additionalProperties": false,
            "required": ["type", "command"],
            "properties": {
              "type": {},
              "command": { "type": "string", "minLength": 1 },
              "package": { "type": "string" },
              "summary": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "mcp" } }, "required": ["type"] },
          "then": {
            "additionalProperties": false,
            "required": ["type", "transport"],
            "properties": {
              "type": {},
              "transport": { "enum": ["stdio", "http"] },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "package": { "type": "string" },
              "tools": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
              },
              "resources": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string" }
              },
              "summary": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "library" } }, "required": ["type"] },
          "then": {
            "additionalProperties": false,
            "required": ["type", "package", "language"],
            "properties": {
              "type": {},
              "package": { "type": "string", "minLength": 1 },
              "language": { "$ref": "#/$defs/language" },
              "summary": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "github-action" } }, "required": ["type"] },
          "then": {
            "additionalProperties": false,
            "required": ["type", "ref"],
            "properties": {
              "type": {},
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                "description": "owner/repo as consumed by uses:"
              },
              "summary": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "http-endpoints" } }, "required": ["type"] },
          "then": {
            "additionalProperties": false,
            "required": ["type", "host", "routes"],
            "properties": {
              "type": {},
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "The application these endpoints are registered into. They are not a standalone server."
              },
              "routes": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "summary": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "desktop-app" } }, "required": ["type"] },
          "then": {
            "additionalProperties": false,
            "required": ["type", "platforms"],
            "properties": {
              "type": {},
              "platforms": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/os" }
              },
              "summary": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pre-commit-hook" } }, "required": ["type"] },
          "then": {
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": {},
              "id": { "$ref": "#/$defs/slug" },
              "summary": { "type": "string" }
            }
          }
        }
      ]
    },
    "distribution": {
      "type": "object",
      "required": ["channel"],
      "properties": {
        "channel": {
          "enum": [
            "npm",
            "pypi",
            "github",
            "desktop-binaries",
            "smithery",
            "gemini-cli-extension"
          ],
          "description": "claude-code-marketplace is intentionally absent: the compiler generates that row from plugins[] (rule R-DIST1)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "channel": { "const": "npm" } }, "required": ["channel"] },
          "then": {
            "additionalProperties": false,
            "required": ["channel", "packages"],
            "properties": {
              "channel": {},
              "packages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "access": { "enum": ["public", "restricted"] }
            }
          }
        },
        {
          "if": { "properties": { "channel": { "const": "pypi" } }, "required": ["channel"] },
          "then": {
            "additionalProperties": false,
            "required": ["channel", "packages"],
            "properties": {
              "channel": {},
              "packages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "if": { "properties": { "channel": { "const": "github" } }, "required": ["channel"] },
          "then": {
            "additionalProperties": false,
            "required": ["channel", "repository"],
            "properties": {
              "channel": {},
              "repository": { "$ref": "#/$defs/repoRef" }
            }
          }
        },
        {
          "if": { "properties": { "channel": { "const": "desktop-binaries" } }, "required": ["channel"] },
          "then": {
            "additionalProperties": false,
            "required": ["channel", "platforms"],
            "properties": {
              "channel": {},
              "platforms": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/os" }
              },
              "via": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "channel": { "const": "smithery" } }, "required": ["channel"] },
          "then": {
            "additionalProperties": false,
            "required": ["channel", "id"],
            "properties": {
              "channel": {},
              "id": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "channel": { "const": "gemini-cli-extension" } }, "required": ["channel"] },
          "then": {
            "additionalProperties": false,
            "required": ["channel", "repository"],
            "properties": {
              "channel": {},
              "repository": { "$ref": "#/$defs/repoRef" }
            }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language"],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "node": { "type": "string", "description": "Semver range, matched against engines.node by rule R-META4." },
        "python": { "type": "string", "description": "Semver range, matched against requires-python by rule R-META4." },
        "os": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/os" }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "The application this product runs inside, when it is not a standalone process."
            },
            "requires": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Host-side requirements, e.g. peer packages and their ranges."
            }
          }
        }
      }
    },
    "language": {
      "enum": ["typescript", "javascript", "python", "rust", "mixed"]
    },
    "os": {
      "enum": ["linux", "macos", "windows"]
    },
    "repoRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "path", "manifest", "components", "status"],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug",
          "description": "Kebab-case, ecosystem-globally unique (rule R-MK4). This is the name users type after @ when installing."
        },
        "host": {
          "enum": ["claude-code", "gemini-cli"],
          "description": "gemini-cli is provisional (open question Q10) and is never eligible for the Claude marketplace."
        },
        "path": {
          "type": "string",
          "pattern": "^(\\.|\\./[A-Za-z0-9_./-]+)$",
          "description": "Plugin root relative to the repository root. '.' means the repository root."
        },
        "manifest": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the host's plugin manifest, relative to the repository root. Verified by rule R-MK5."
        },
        "marketplace": {
          "$ref": "#/$defs/slug",
          "description": "Required when host is claude-code. Must equal the canonical marketplace id (rule R-MK6). This is the anti-fragmentation field."
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": { "type": "integer", "minimum": 0 },
            "agents": { "type": "integer", "minimum": 0 },
            "commands": { "type": "integer", "minimum": 0 },
            "hooks": { "type": "boolean" },
            "mcp": { "type": "boolean" }
          },
          "description": "Declared inventory, verified against the repository by rule R-MK7. Counts, not names: names change every release."
        },
        "status": { "enum": ["published", "deprecated"] }
      },
      "allOf": [
        {
          "if": { "properties": { "host": { "const": "claude-code" } }, "required": ["host"] },
          "then": { "required": ["marketplace"] }
        }
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "type", "interface", "status"],
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "A Nextbridge product id, or an external product name when external is true."
        },
        "external": {
          "type": "boolean",
          "default": false,
          "description": "True when the target is not a Nextbridge product."
        },
        "type": {
          "enum": [
            "context-provider",
            "graph-producer",
            "graph-consumer",
            "governance",
            "runtime-guard",
            "file-selector",
            "pre-install-verification",
            "compatibility-check",
            "config-import",
            "methodology-extension",
            "host-plugin",
            "tool-orchestration"
          ]
        },
        "interface": {
          "enum": ["cli", "mcp", "library", "file", "http", "subprocess", "plugin"]
        },
        "status": {
          "enum": ["proposed", "experimental", "supported", "verified"],
          "description": "Only supported and verified may be presented publicly. verified additionally requires a verification block (rule R-REF4)."
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "produces": { "type": "string" },
            "consumes": { "type": "string" }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["automated"],
          "properties": {
            "automated": { "type": "boolean" },
            "workflow": { "type": "string" },
            "test": { "type": "string" }
          }
        }
      }
    }
  }
}
